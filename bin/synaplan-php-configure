# =============================================================================
# synaplan-php-configure
# -----------------------------------------------------------------------------
# Materializes runtime PHP/FrankenPHP configuration based on APP_ENV and
# PHP_*/FRANKENPHP_* environment variables.
#
# Designed to be **sourced** (or run) from any downstream image's entrypoint
# BEFORE invoking php / frankenphp:
#
#     source /usr/local/bin/synaplan-php-configure
#
# The script is idempotent on container restart and never exits the parent
# shell — it reports problems via stderr and continues, so that the parent
# entrypoint stays in control of fatal-vs-nonfatal startup behavior.
#
# Side effects, in order:
#   1. Writes /usr/local/etc/php/conf.d/99-synaplan-env.ini from PHP_* env vars
#      (only directives explicitly set in env are emitted — defaults stay
#      defined in the baked 10-/20-/30-/40-... ini files).
#   2. Activates the dev override (templates/synaplan-dev.ini ->
#      conf.d/99-synaplan-dev.ini) when APP_ENV=dev; removes it otherwise.
#   3. Wires opcache.preload when PHP_OPCACHE_PRELOAD is set and points to a
#      readable file (downstream apps opt in without forking the image).
#   4. Materializes /etc/caddy/synaplan-worker-mode.Caddyfile from the
#      template when APP_ENV=prod and FRANKENPHP_WORKER_ENABLED is not "0";
#      writes an empty stub otherwise so a downstream `import` is a no-op.
# =============================================================================

# Don't rely on `set -e` from the caller — keep our errors local.
__synaplan_log() { printf '[synaplan-php-configure] %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Layout (constants)
# ---------------------------------------------------------------------------
__synaplan_php_confd="${SYNAPLAN_PHP_CONFD:-/usr/local/etc/php/conf.d}"
__synaplan_php_templates="${SYNAPLAN_PHP_TEMPLATES:-/usr/local/etc/php/templates}"
__synaplan_caddy_etc="${SYNAPLAN_CADDY_ETC:-/etc/caddy}"

__synaplan_env_ini="${__synaplan_php_confd}/99-synaplan-env.ini"
__synaplan_dev_ini="${__synaplan_php_confd}/99-synaplan-dev.ini"
__synaplan_dev_template="${__synaplan_php_templates}/synaplan-dev.ini"
__synaplan_worker_template="${__synaplan_php_templates}/synaplan-worker-mode.Caddyfile"
__synaplan_worker_active="${__synaplan_caddy_etc}/synaplan-worker-mode.Caddyfile"

# ---------------------------------------------------------------------------
# 1. Render PHP_* env vars -> 99-synaplan-env.ini
#
# Only emit a directive when the corresponding env var is explicitly set
# (including empty string -> means "leave default"). This keeps the override
# surface minimal and predictable: env wins, baked ini files set the floor.
# ---------------------------------------------------------------------------
__synaplan_render_env_ini() {
    local tmp
    tmp="$(mktemp)" || { __synaplan_log "WARN: mktemp failed; skipping env ini render"; return 0; }

    {
        printf '; Auto-generated by synaplan-php-configure on container startup.\n'
        printf '; DO NOT EDIT — edits are discarded on next restart.\n'
        printf '; Set PHP_* env vars on the container to override values here.\n\n'

        # Pairs: ENV_VAR  ini_directive
        local pair env_var directive value
        for pair in \
            "PHP_MEMORY_LIMIT|memory_limit" \
            "PHP_UPLOAD_MAX_FILESIZE|upload_max_filesize" \
            "PHP_POST_MAX_SIZE|post_max_size" \
            "PHP_MAX_FILE_UPLOADS|max_file_uploads" \
            "PHP_MAX_EXECUTION_TIME|max_execution_time" \
            "PHP_MAX_INPUT_TIME|max_input_time" \
            "PHP_MAX_INPUT_VARS|max_input_vars" \
            "PHP_TIMEZONE|date.timezone" \
            "PHP_DISPLAY_ERRORS|display_errors" \
            "PHP_ERROR_REPORTING|error_reporting" \
            "PHP_OPCACHE_MEMORY_CONSUMPTION|opcache.memory_consumption" \
            "PHP_OPCACHE_MAX_ACCELERATED_FILES|opcache.max_accelerated_files" \
            "PHP_OPCACHE_INTERNED_STRINGS_BUFFER|opcache.interned_strings_buffer" \
            "PHP_OPCACHE_VALIDATE_TIMESTAMPS|opcache.validate_timestamps" \
            "PHP_OPCACHE_REVALIDATE_FREQ|opcache.revalidate_freq" \
            "PHP_OPCACHE_JIT|opcache.jit" \
            "PHP_OPCACHE_JIT_BUFFER_SIZE|opcache.jit_buffer_size" \
            "PHP_REALPATH_CACHE_SIZE|realpath_cache_size" \
            "PHP_REALPATH_CACHE_TTL|realpath_cache_ttl" \
            "PHP_APC_SHM_SIZE|apc.shm_size" \
            "PHP_APC_ENABLED|apc.enabled"
        do
            env_var="${pair%%|*}"
            directive="${pair##*|}"
            # Use parameter expansion to detect "explicitly set" (including empty).
            if [ -n "${!env_var+x}" ]; then
                value="${!env_var}"
                printf '%s = %s\n' "$directive" "$value"
            fi
        done

        # opcache.preload is special: only emit when the file actually exists,
        # so a stale env var doesn't crash php startup.
        if [ -n "${PHP_OPCACHE_PRELOAD:-}" ]; then
            if [ -r "${PHP_OPCACHE_PRELOAD}" ]; then
                printf 'opcache.preload = %s\n' "${PHP_OPCACHE_PRELOAD}"
                # preload runs as the user that started php; in the Synaplan
                # image that is www-data via FrankenPHP. Match it.
                printf 'opcache.preload_user = %s\n' "${PHP_OPCACHE_PRELOAD_USER:-www-data}"
            else
                __synaplan_log "WARN: PHP_OPCACHE_PRELOAD=${PHP_OPCACHE_PRELOAD} is not a readable file; skipping preload."
            fi
        fi
    } > "$tmp"

    if mv -f "$tmp" "$__synaplan_env_ini" 2>/dev/null; then
        __synaplan_log "rendered ${__synaplan_env_ini}"
    else
        __synaplan_log "WARN: could not write ${__synaplan_env_ini}"
        rm -f "$tmp" 2>/dev/null || true
    fi
}

# ---------------------------------------------------------------------------
# 2. APP_ENV=dev -> activate dev override; otherwise remove any leftover.
# ---------------------------------------------------------------------------
__synaplan_apply_dev_override() {
    if [ "${APP_ENV:-prod}" = "dev" ]; then
        if [ -r "$__synaplan_dev_template" ]; then
            cp -f "$__synaplan_dev_template" "$__synaplan_dev_ini"
            __synaplan_log "APP_ENV=dev -> activated dev override (${__synaplan_dev_ini})"
        else
            __synaplan_log "WARN: APP_ENV=dev but ${__synaplan_dev_template} is missing"
        fi
    else
        # Idempotent cleanup: a previous container run may have been APP_ENV=dev.
        if [ -e "$__synaplan_dev_ini" ]; then
            rm -f "$__synaplan_dev_ini"
            __synaplan_log "APP_ENV=${APP_ENV:-prod} -> removed dev override"
        fi
    fi
}

# ---------------------------------------------------------------------------
# 3. Worker-mode Caddyfile snippet
#
# Activates only when APP_ENV=prod and FRANKENPHP_WORKER_ENABLED != "0".
# Default to enabled in prod because that's the entire point of the
# 3-node cluster setup; ops opts out by setting FRANKENPHP_WORKER_ENABLED=0.
# ---------------------------------------------------------------------------
__synaplan_apply_worker_mode() {
    mkdir -p "$__synaplan_caddy_etc" 2>/dev/null || true

    local enabled="${FRANKENPHP_WORKER_ENABLED:-}"
    if [ "${APP_ENV:-prod}" = "prod" ] && [ "$enabled" != "0" ] && [ "$enabled" != "false" ]; then
        if [ -r "$__synaplan_worker_template" ]; then
            cp -f "$__synaplan_worker_template" "$__synaplan_worker_active"
            __synaplan_log "APP_ENV=prod -> FrankenPHP worker mode ON (${__synaplan_worker_active})"
        else
            __synaplan_log "WARN: worker-mode template missing at ${__synaplan_worker_template}; falling back to classic SAPI"
            __synaplan_write_classic_sapi_stub
        fi
    else
        __synaplan_write_classic_sapi_stub
        __synaplan_log "FrankenPHP worker mode OFF (classic SAPI stub at ${__synaplan_worker_active})"
    fi
}

# Classic-SAPI stub: a bare `frankenphp` directive. The downstream Caddyfile's
# global block imports this file unconditionally, so the stub must still
# enable PHP processing even when worker mode is off.
__synaplan_write_classic_sapi_stub() {
    cat > "$__synaplan_worker_active" <<'EOF'
# FrankenPHP classic SAPI stub (worker mode disabled).
# Generated by /usr/local/bin/synaplan-php-configure.
frankenphp
EOF
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
__synaplan_render_env_ini
__synaplan_apply_dev_override
__synaplan_apply_worker_mode

# Don't leak helper functions / vars into the parent shell.
unset -f __synaplan_log __synaplan_render_env_ini __synaplan_apply_dev_override __synaplan_apply_worker_mode __synaplan_write_classic_sapi_stub
unset __synaplan_php_confd __synaplan_php_templates __synaplan_caddy_etc
unset __synaplan_env_ini __synaplan_dev_ini __synaplan_dev_template
unset __synaplan_worker_template __synaplan_worker_active

# When invoked directly (not sourced) and given args, exec them.
# This lets the file double as an ENTRYPOINT shim: `ENTRYPOINT ["synaplan-php-configure", "frankenphp", "run"]`.
# `${BASH_SOURCE[0]}` differs from `$0` when sourced.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ] && [ "$#" -gt 0 ]; then
    exec "$@"
fi
